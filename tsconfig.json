{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "jsx": "react-native",
    // Keep in sync with the resolver in metro.config.js and the jest
    // "moduleNameMapper" in package.json.
    "paths": {
      "@components/*": ["./src/components/*"],
      "@helpers/*": ["./src/utils/helpers/*"],
      "@styles/*": ["./src/styles/*"]
    }
  }
}
