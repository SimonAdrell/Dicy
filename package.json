{
  "name": "dicy",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "start": "react-native start",
    "test": "jest",
    "check-dependencies": "rnx-align-deps",
    "fix-dependencies": "rnx-align-deps --write",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.json": [
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "transformIgnorePatterns": [
      "/node_modules/(?!(react-native|@react-native|react-native-modal|react-native-animatable|@react-native-vector-icons|@react-navigation|react-native-mmkv|react-native-nitro-modules|nitro-core)/)"
    ],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx|mjs)$": "babel-jest"
    },
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@helpers/(.*)$": "<rootDir>/src/utils/helpers/$1",
      "^@styles/(.*)$": "<rootDir>/src/styles/$1"
    }
  },
  "dependencies": {
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.28.6",
    "@babel/plugin-transform-optional-chaining": "^7.28.6",
    "@os-team/i18next-react-native-language-detector": "^1.1.6",
    "@react-native-vector-icons/material-design-icons": "^14.0.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@sayem314/react-native-keep-awake": "^2.0.0",
    "@typescript-eslint/utils": "^8.57.2",
    "i18next": "^27.1.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "lottie-react-native": "^7.5.0",
    "react": "19.3.1",
    "react-i18next": "^18.0.1",
    "react-native": "0.88.1",
    "react-native-image-crop-picker": "^0.52.0",
    "react-native-localize": "^3.7.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-modal": "13.0.1",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-simple-dialogs": "^2.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/runtime": "^7.29.2",
    "@jest/globals": "^29.7.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@rnx-kit/align-deps": "^5.0.1",
    "@testing-library/react-native": "^13.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "babel-jest": "^29.6.3",
    "eslint": "^8.57.0",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-jest": "^29.15.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-testing-library": "^6.4.0",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "lint-staged": "^15.3.0",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.3.1",
    "ts-jest": "^29.4.6",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.2",
    "handlebars": "^4.7.9",
    "lodash": "^4.17.24",
    "brace-expansion": "^2.1.4",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "rnx-kit": {
    "kitType": "app",
    "alignDeps": {
      "requirements": [
        "react-native@0.88"
      ],
      "capabilities": [
        "babel-preset-react-native",
        "core",
        "core-android",
        "core-ios",
        "core/metro-config",
        "jest",
        "modal",
        "navigation/native",
        "react",
        "react-test-renderer",
        "safe-area",
        "screens"
      ]
    }
  }
}
